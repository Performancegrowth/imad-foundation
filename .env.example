# ==================================================================
# Imad (عِماد) — Environment Template
# Copy to .env and fill in real values. Never commit .env to git.
# ==================================================================

# ── Core Application ──────────────────────────────────────────────
APP_NAME=Imad
APP_ENV=development                # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── Security ──────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret
# JWT signing secret. Regenerate with `openssl rand -hex 32`.
JWT_SECRET_KEY=change-me-to-a-long-random-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440     # 24 hours in minutes
REFRESH_TOKEN_EXPIRE_MINUTES=43200   # 30 days in minutes
ALGORITHM=HS256
# Comma-separated development users (see core/security.py)
FIRST_SUPERUSER=admin@imad.dev
FIRST_SUPERUSER_PASSWORD=change-me-superuser-password

# ── Database ──────────────────────────────────────────────────────
# Sprint 0 uses the bundled SQLite schema at database/schema.sql.
# For production switch to PostgreSQL (SQLAlchemy URL compatible).
DATABASE_URL=sqlite:///./imad.db
# DATABASE_URL=postgresql+asyncpg://imad:imad@localhost:5432/imad
# PostgreSQL password (if using Postgres). Regenerate with `openssl rand -hex 32`.
POSTGRES_PASSWORD=change-me-postgres-password

# ── AI / Integration Providers (Sprint 3+) ────────────────────────
AI_PROVIDER=openai                  # openai | anthropic | bedrock | azure_openai (reserved)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2

# ── Structural Engine (Sprint 0 placeholder, see services) ─────────
STRUCTURAL_ENGINE_MAX_CRITICAL_SECTIONS=64

# ── Upload Constraints ────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=128
ALLOWED_CAD_EXTENSIONS=.dxf,.dwg,.ifc,.obj
ALLOWED_NONCAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.webp
SURVEY_MAX_ENTRIES=5000

# ── Deployment / Queue (Sprint 14) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434
UPLOAD_DIR=./storage/uploads
RESULTS_DIR=./storage/results

# ── Frontend ──────────────────────────────────────────────────────
VITE_APP_API_BASE=http://localhost:8000/api/v1
VITE_APP_NAME=Imad