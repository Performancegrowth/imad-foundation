# ------------------------------------------------------------------
# Imad (عِماد) — Sprint 0 / Repository ignore rules
# ------------------------------------------------------------------

# ── Operating System ──────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*~

# ── Editors / IDEs ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Environment & Secrets ─────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
*.pem
*.key
*.p12
*.pfx
secrets/

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
dist/
build/
*.egg-info/
.python-version/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ── FastAPI / Uvicorn ─────────────────────────────────────────────
*.log
*.sqlite3
*.db
*.sqlite

# ── Uploads / Generated Design Outputs ────────────────────────────
backend/uploads/
uploads/
storage/
/outputs
garbage collector
*.tmp

# ── Node / Frontend ───────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
*.tgz
*.tar.gz
*.rar
*.zip
.vite/
.next/

# ── Docker ────────────────────────────────────────────────────────
# System images (large, generated) are ignored already via dist/
docker-data/