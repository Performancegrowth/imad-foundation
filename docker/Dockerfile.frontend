# ==================================================================
# Imad — Frontend container (static landing / docs placeholder)
# Sprint 0 serves the static site from frontend/public.
# Future sprints will swap this to a Node/Vite build stage.
# ==================================================================
FROM node:22-alpine AS build
WORKDIR /src
COPY ./frontend/package.json ./package.json
# Reserved: run `npm install && npm run build` here when a build step exists.

FROM nginx:1.27-alpine AS serve
WORKDIR /usr/share/nginx/html
COPY ./frontend/ ./html/
COPY docker/frontend.nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80