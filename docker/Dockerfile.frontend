# ==================================================================
# Imad — Frontend container (multi-stage: builds the Vite app inside
# the image, then serves the fresh dist/ via nginx).
#
# Stage 1 compiles frontend/app/ so the image always contains the
# current source — no stale pre-built dist/ is ever copied in.
# Stage 2 serves the result with nginx.
# ==================================================================
# Stage 1 — build
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/app/package*.json ./
RUN npm ci
COPY frontend/app/ ./
RUN npm run build

# Stage 2 — serve
FROM nginx:1.27-alpine AS serve
COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY docker/frontend.nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80