# ==================================================================
# Imad — Frontend container (serves the built Vite app via nginx)
#
# The Vite app is a React project at frontend/app/. Its production build
# output (frontend/app/dist/) is what nginx serves. To change content,
# run `npm install && npm run build` inside frontend/app/ first; the
# freshly generated dist/ is picked up by this image on rebuild.
# ==================================================================
FROM nginx:1.27-alpine AS serve
WORKDIR /usr/share/nginx/html
COPY ./frontend/app/dist/ /usr/share/nginx/html/
COPY docker/frontend.nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80